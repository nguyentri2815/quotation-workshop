{
  "name": "quotation-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "checkpoints": "node scripts/prepare-source.mjs",
    "predev": "npm run checkpoints",
    "dev": "vite --host localhost --port 3181",
    "typecheck": "npm run checkpoints && tsc --noEmit && tsc --noEmit -p tsconfig.checkpoints.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host localhost --port 3181",
    "pretest": "npm run checkpoints",
    "test": "vitest run",
    "test:browser": "playwright test",
    "pretest:journey": "npm run checkpoints",
    "test:journey": "node tests/journey.mjs",
    "test:hmr": "node tests/hmr.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "diff": "9.0.0",
    "lucide-react": "1.64.0",
    "msw": "3.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.15.2",
    "react-router-dom": "7.18.5",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "postcss": "8.5.32",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
